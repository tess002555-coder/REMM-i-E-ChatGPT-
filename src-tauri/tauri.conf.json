{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RememberME V2",
  "version": "0.1.0",
  "identifier": "com.rememberme.widget.v2",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Remember ME",
        "width": 180,
        "height": 180,
        "minWidth": 180,
        "minHeight": 180,
        "maxWidth": 180,
        "maxHeight": 180,
        "resizable": false,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": true,
        "focus": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "category": "Productivity",
    "shortDescription": "Remember ME floating mascot widget"
  }
}
