<Window x:Class="RemmI.RoutineWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="330" Height="560" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" Background="Transparent" AllowsTransparency="True">
    <Border Margin="2" CornerRadius="22" Background="#F5171A20" BorderBrush="#22D3EE" BorderThickness="1" Padding="12">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,12"><TextBlock Text="● DETAIL RUTINITAS" Foreground="#22D3EE" FontSize="11" FontWeight="Bold"/><Button Content="×" Width="26" Height="26" HorizontalAlignment="Right" Click="Close_Click" Background="#20242A" Foreground="#DDEAF0" BorderBrush="#343C47"/></Grid>
            <Border Grid.Row="1" CornerRadius="12" Background="#20242A" BorderBrush="#343C47" BorderThickness="1" Padding="12" Margin="0,0,0,8"><StackPanel><TextBlock Text="NAMA RUTINITAS" Foreground="#7F8C99" FontSize="8" HorizontalAlignment="Center"/><TextBlock x:Name="RoutineTitle" Text="REMMIE Project" Foreground="#22D3EE" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel></Border>
            <Button Grid.Row="2" Content="↗  Ekspor Kartu Pencapaian (Medos)" Height="31" Click="Export_Click" Background="#17333A" Foreground="#22D3EE" BorderBrush="#22D3EE" FontWeight="Bold" Margin="0,0,0,8"/>
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"><StackPanel>
                <Border CornerRadius="12" Background="#171A1F" BorderBrush="#303742" BorderThickness="1" Padding="9" Margin="0,0,0,8"><StackPanel><TextBlock x:Name="MonthText" Foreground="#22D3EE" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6"/><UniformGrid x:Name="CalendarGrid" Columns="7"/></StackPanel></Border>
                <Border CornerRadius="12" Background="#20242A" BorderBrush="#343C47" BorderThickness="1" Padding="10"><StackPanel><TextBlock Text="CATATAN TANGGAL" Foreground="#AFC0CF" FontSize="9" FontWeight="Bold"/><TextBox x:Name="NotesBox" Height="78" Margin="0,7,0,0" Background="#171A1F" Foreground="#E8F7FC" BorderBrush="#303742" TextWrapping="Wrap" AcceptsReturn="True"/></StackPanel></Border>
            </StackPanel></ScrollViewer>
            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,9,0,0"><Button Content="Simpan Catatan" Width="125" Height="30" Click="Save_Click" Background="#22D3EE" Foreground="#061015" BorderThickness="0" FontWeight="Bold"/><Button Content="Hapus Rutinitas Ini" Width="125" Height="30" Margin="8,0,0,0" Click="Delete_Click" Background="#3A2027" Foreground="#FCA5A5" BorderBrush="#6B303D"/></StackPanel>
        </Grid>
    </Border>
</Window>
