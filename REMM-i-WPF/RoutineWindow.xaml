<Window x:Class="RemmI.RoutineWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="350" Height="600" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" Background="Transparent" AllowsTransparency="True">
    <Border Margin="2" CornerRadius="20" Background="#F0181D24" BorderBrush="#00A8B5" BorderThickness="1" Padding="14">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,12"><TextBlock Text="● DETAIL RUTINITAS" Foreground="#00D2D3" FontSize="11" FontWeight="Bold"/><Button Content="×" Width="26" Height="26" HorizontalAlignment="Right" Click="Close_Click" Background="#222228" Foreground="#DDEAF0" BorderBrush="#353D44"/></Grid>
            <Border Grid.Row="1" CornerRadius="12" Background="#222228" BorderBrush="#353D44" BorderThickness="1" Padding="14" Margin="0,0,0,8"><StackPanel><TextBlock Text="NAMA RUTINITAS" Foreground="#68747C" FontSize="8" HorizontalAlignment="Center"/><TextBlock x:Name="RoutineTitle" Text="REMMIE Project" Foreground="#00D2D3" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel></Border>
            <Button Grid.Row="2" Content="↗  Ekspor Kartu Pencapaian (Medos)" Height="31" Click="Export_Click" Background="#17333A" Foreground="#00D2D3" BorderBrush="#00A8B5" FontWeight="Bold" Margin="0,0,0,8"/>
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"><StackPanel>
                <Border CornerRadius="12" Background="#18181C" BorderBrush="#353D44" BorderThickness="1" Padding="9" Margin="0,0,0,8"><StackPanel><TextBlock x:Name="MonthText" Foreground="#00D2D3" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6"/><UniformGrid x:Name="CalendarGrid" Columns="7"/></StackPanel></Border>
                <Border CornerRadius="12" Background="#222228" BorderBrush="#353D44" BorderThickness="1" Padding="10"><StackPanel><TextBlock Text="CATATAN TANGGAL" Foreground="#AAB4BA" FontSize="9" FontWeight="Bold"/><TextBox x:Name="NotesBox" Height="78" Margin="0,7,0,0" Background="#18181C" Foreground="#E8F7FC" BorderBrush="#353D44" TextWrapping="Wrap" AcceptsReturn="True"/></StackPanel></Border>
            </StackPanel></ScrollViewer>
            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,9,0,0"><Button Content="Simpan Catatan" Width="130" Height="32" Style="{StaticResource RemmPrimaryButton}" Click="Save_Click" Background="#00D2D3" Foreground="#061015" BorderThickness="0" FontWeight="Bold"/><Button Content="Hapus Rutinitas Ini" Width="130" Height="32" Style="{StaticResource RemmDangerButton}" Margin="8,0,0,0" Click="Delete_Click" Background="#32191D" Foreground="#FF6670" BorderBrush="#8E3038"/></StackPanel>
        </Grid>
    </Border>
</Window>
