<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="RemmWindowButton" TargetType="Button">
        <Setter Property="Height" Value="30"/>
        <Setter Property="MinWidth" Value="30"/>
        <Setter Property="Padding" Value="9,0"/>
        <Setter Property="Background" Value="#20252C"/>
        <Setter Property="Foreground" Value="#DDEAF0"/>
        <Setter Property="BorderBrush" Value="#35404A"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value><ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate></Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="RemmPrimaryButton" TargetType="Button" BasedOn="{StaticResource RemmWindowButton}">
        <Setter Property="Background" Value="{StaticResource RemmAccent}"/>
        <Setter Property="Foreground" Value="#061015"/>
        <Setter Property="BorderBrush" Value="{StaticResource RemmAccent}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="RemmDangerButton" TargetType="Button" BasedOn="{StaticResource RemmWindowButton}">
        <Setter Property="Background" Value="#32191D"/>
        <Setter Property="Foreground" Value="#FF6670"/>
        <Setter Property="BorderBrush" Value="#8E3038"/>
    </Style>
    <Style x:Key="RemmTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource RemmInput}"/>
        <Setter Property="Foreground" Value="{StaticResource RemmText}"/>
        <Setter Property="BorderBrush" Value="#353D44"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
</ResourceDictionary>