<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="RemmBackgroundColor">#18181C</Color>
    <Color x:Key="RemmSurfaceColor">#222228</Color>
    <Color x:Key="RemmSurface2Color">#29292F</Color>
    <Color x:Key="RemmInputColor">#15151A</Color>
    <Color x:Key="RemmAccentColor">#00D2D3</Color>
    <Color x:Key="RemmAccentDarkColor">#00A8B5</Color>
    <Color x:Key="RemmAccentSoftColor">#123D45</Color>
    <Color x:Key="RemmTextColor">#F4F7F8</Color>
    <Color x:Key="RemmSecondaryTextColor">#AAB4BA</Color>
    <Color x:Key="RemmMutedTextColor">#68747C</Color>
    <Color x:Key="RemmHighColor">#FF4D4D</Color>
    <Color x:Key="RemmMediumColor">#FFA500</Color>
    <Color x:Key="RemmLowColor">#2ECC71</Color>
    <Color x:Key="RemmDangerColor">#FF4D5A</Color>
    <SolidColorBrush x:Key="RemmBackground" Color="{StaticResource RemmBackgroundColor}"/>
    <SolidColorBrush x:Key="RemmSurface" Color="{StaticResource RemmSurfaceColor}"/>
    <SolidColorBrush x:Key="RemmSurface2" Color="{StaticResource RemmSurface2Color}"/>
    <SolidColorBrush x:Key="RemmInput" Color="{StaticResource RemmInputColor}"/>
    <SolidColorBrush x:Key="RemmAccent" Color="{StaticResource RemmAccentColor}"/>
    <SolidColorBrush x:Key="RemmAccentDark" Color="{StaticResource RemmAccentDarkColor}"/>
    <SolidColorBrush x:Key="RemmAccentSoft" Color="{StaticResource RemmAccentSoftColor}"/>
    <SolidColorBrush x:Key="RemmText" Color="{StaticResource RemmTextColor}"/>
    <SolidColorBrush x:Key="RemmSecondaryText" Color="{StaticResource RemmSecondaryTextColor}"/>
    <SolidColorBrush x:Key="RemmMutedText" Color="{StaticResource RemmMutedTextColor}"/>
    <SolidColorBrush x:Key="RemmHigh" Color="{StaticResource RemmHighColor}"/>
    <SolidColorBrush x:Key="RemmMedium" Color="{StaticResource RemmMediumColor}"/>
    <SolidColorBrush x:Key="RemmLow" Color="{StaticResource RemmLowColor}"/>
    <SolidColorBrush x:Key="RemmDanger" Color="{StaticResource RemmDangerColor}"/>
</ResourceDictionary>