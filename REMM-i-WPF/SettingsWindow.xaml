<Window x:Class="RemmI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="390" Height="800"
        MinWidth="390" MinHeight="650" MaxWidth="390" MaxHeight="800"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        AllowsTransparency="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="TabButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#9AA6B2" />
            <Setter Property="Background" Value="#0F1216" />
            <Setter Property="BorderBrush" Value="#2B323B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border CornerRadius="9"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="#061015" />
                    <Setter Property="Background" Value="#19CBE8" />
                    <Setter Property="BorderBrush" Value="#19CBE8" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SectionBorder" TargetType="Border">
            <Setter Property="Background" Value="#15191E" />
            <Setter Property="BorderBrush" Value="#303740" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="CompactButton" TargetType="Button">
            <Setter Property="Background" Value="#191E24" />
            <Setter Property="Foreground" Value="#D7E1E8" />
            <Setter Property="BorderBrush" Value="#323A44" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0D1014" />
            <Setter Property="Foreground" Value="#E7F7FC" />
            <Setter Property="BorderBrush" Value="#303741" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#0D1014" />
            <Setter Property="Foreground" Value="#E7F7FC" />
            <Setter Property="BorderBrush" Value="#303741" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Height" Value="29" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#DCE5EB" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,2,0,4" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource CompactButton}" />
    </Window.Resources>

    <Border Margin="4" CornerRadius="15" Background="#F50E1116" BorderBrush="#303944" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="14,12,14,6" MouseLeftButtonDown="Header_MouseLeftButtonDown" Cursor="SizeAll">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Pengaturan Terpusat" Foreground="#F4F8FA" FontSize="15" FontWeight="Bold" />
                    <TextBlock Text="Konfigurasi Maskot, UI, &amp; Suara Notifikasi" Foreground="#71808C" FontSize="8" Margin="0,1,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="×" Width="30" Height="30" Padding="0" FontSize="14" Click="Close_Click" />
            </Grid>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="11,0,11,7">
                <RadioButton x:Name="TabMascot" GroupName="MainTabs" Content="⚙  Maskot &amp; Tampilan" Style="{StaticResource TabButton}" IsChecked="True" Click="MainTab_Click" />
                <RadioButton x:Name="TabSound" GroupName="MainTabs" Content="♫  Notifikasi &amp; Suara" Style="{StaticResource TabButton}" Click="MainTab_Click" />
                <RadioButton x:Name="TabData" GroupName="MainTabs" Content="▤  Integrasi &amp; Data" Style="{StaticResource TabButton}" Click="MainTab_Click" />
            </StackPanel>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="11,0,11,8">
                    <StackPanel x:Name="MascotSection">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                            <RadioButton x:Name="SubTheme" GroupName="SubTabs" Content="◉  Warna &amp; Tema" Style="{StaticResource TabButton}" IsChecked="True" Click="SubTab_Click" />
                            <RadioButton x:Name="SubInteract" GroupName="SubTabs" Content="⚙  Interaksi" Style="{StaticResource TabButton}" Click="SubTab_Click" />
                            <RadioButton x:Name="SubPose" GroupName="SubTabs" Content="▧  Gambar Pose" Style="{StaticResource TabButton}" Click="SubTab_Click" />
                        </StackPanel>

                        <StackPanel x:Name="ThemePanel">
                            <Border Style="{StaticResource SectionBorder}">
                                <StackPanel>
                                    <TextBlock Text="Mode Tampilan Floating Widget" Foreground="#19D2EF" FontSize="10" FontWeight="Bold" />
                                    <Grid Margin="0,7,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <RadioButton x:Name="ModeBar" GroupName="PanelMode" IsChecked="True" Margin="0,0,4,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="▌" Foreground="#19D2EF" FontWeight="Bold" Margin="0,0,5,0" />
                                                <StackPanel><TextBlock Text="Mode Bar (Bilah Sisi)" FontWeight="SemiBold"/><TextBlock Text="Bilah vertikal minimal di sisi layar tanpa frame/gambar." Foreground="#788692" FontSize="7.5" TextWrapping="Wrap"/></StackPanel>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="ModeFloat" Grid.Column="1" GroupName="PanelMode" Margin="4,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="▣" Foreground="#19D2EF" FontWeight="Bold" Margin="0,0,5,0" />
                                                <StackPanel><TextBlock Text="Mode Maskot Mengambang" FontWeight="SemiBold"/><TextBlock Text="Tampilkan foto/gambar maskot utuh yang Anda upload." Foreground="#788692" FontSize="7.5" TextWrapping="Wrap"/></StackPanel>
                                            </StackPanel>
                                        </RadioButton>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionBorder}">
                                <StackPanel>
                                    <TextBlock Text="Identitas Header Floating Panel" Foreground="#19D2EF" FontSize="10" FontWeight="Bold" />
                                    <Grid Margin="0,7,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,4,0"><TextBlock Text="Nama Project / Judul Panel" Foreground="#7F8D99" FontSize="7.5" Margin="0,0,0,2"/><TextBox x:Name="ProjectNameText" Text="REMM(i)E" /></StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBlock Text="Nama Pengguna / Sub-Judul" Foreground="#7F8D99" FontSize="7.5" Margin="0,0,0,2"/><TextBox x:Name="DisplayNameText" Text="Maskot Denia" /></StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionBorder}">
                                <StackPanel>
                                    <DockPanel><TextBlock Text="Preset Tema 1-Klik (Theme Presets)" Foreground="#19D2EF" FontSize="10" FontWeight="Bold"/><Button Content="Instan Ubah Seluruh Warna" IsEnabled="False" DockPanel.Dock="Right" FontSize="7" Padding="2" Background="Transparent" BorderThickness="0" Foreground="#6E7C87"/></DockPanel>
                                    <WrapPanel Margin="0,7,0,0">
                                        <Button Content="●  Cyberpunk Neon" Click="Theme_Click" Tag="Cyberpunk Neon" Margin="1,2" Padding="7,4" />
                                        <Button Content="●  Soft Sakura Pink" Click="Theme_Click" Tag="Soft Sakura Pink" Margin="1,2" Padding="7,4" Background="#F5CFDA" Foreground="#3A1721" />
                                        <Button Content="●  Clean Milk White" Click="Theme_Click" Tag="Clean Milk White" Margin="1,2" Padding="7,4" Background="#F8F8F8" Foreground="#252525" />
                                        <Button Content="●  Minimal Obsidian" Click="Theme_Click" Tag="Minimal Obsidian" Margin="1,2" Padding="7,4" />
                                        <Button Content="●  Emerald Forest" Click="Theme_Click" Tag="Emerald Forest" Margin="1,2" Padding="7,4" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionBorder}">
                                <StackPanel>
                                    <TextBlock Text="Transparansi &amp; Warna Kustom" Foreground="#19D2EF" FontSize="10" FontWeight="Bold" />
                                    <DockPanel Margin="0,7,0,0"><TextBlock Text="Transparansi / Opacity Panel" Foreground="#D4DDE3" FontSize="8"/><TextBlock x:Name="OpacityValue" DockPanel.Dock="Right" Foreground="#19D2EF" FontSize="8" FontWeight="Bold" Text="95%"/></DockPanel>
                                    <Slider x:Name="OpacitySlider" Minimum="0.65" Maximum="1" Value="0.95" ValueChanged="OpacitySlider_ValueChanged" />
                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,4,0"><TextBlock Text="Warna Latar Panel" Foreground="#7F8D99" FontSize="7.5"/><TextBox x:Name="BackgroundColorText" Text="#15181D" /></StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBlock Text="Warna Bingkai / Border Panel" Foreground="#7F8D99" FontSize="7.5"/><TextBox x:Name="BorderColorText" Text="#22D3EE" /></StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="InteractPanel" Visibility="Collapsed">
                            <Border Style="{StaticResource SectionBorder}">
                                <StackPanel>
                                    <TextBlock Text="Perilaku &amp; Interaksi Maskot Denia" Foreground="#19D2EF" FontSize="10" FontWeight="Bold" />
                                    <CheckBox x:Name="DragEnabledCheck" Content="Izinkan drag &amp; pindah widget" IsChecked="True" Margin="0,9,0,5" />
                                    <CheckBox x:Name="AutoSnapCheck" Content="Auto snap ke sisi layar terdekat saat dilepas" IsChecked="True" />
                                    <CheckBox Content="Tampilkan menu utama sebagai jendela terpisah" IsChecked="True" IsEnabled="False" />
                                    <CheckBox Content="Pertahankan mascot selalu di atas desktop" IsChecked="True" IsEnabled="False" />
                                    <DockPanel Margin="0,7,0,0"><TextBlock Text="Peek gambar maskot (tetap 50%)" Foreground="#7F8D99" FontSize="8"/><TextBlock DockPanel.Dock="Right" Text="75%" Foreground="#19D2EF" FontSize="8"/></DockPanel>
                                    <Slider x:Name="PeekSlider" Minimum="50" Maximum="90" Value="75" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SectionBorder}">
                                <StackPanel>
                                    <TextBlock Text="Mode Window" Foreground="#19D2EF" FontSize="10" FontWeight="Bold" />
                                    <TextBlock Text="Mode Bar menempatkan panel seperti sidebar. Mode Mengambang mempertahankan panel di dekat mascot." Foreground="#7F8D99" FontSize="8" Margin="0,5,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="PosePanel" Visibility="Collapsed">
                            <Border Style="{StaticResource SectionBorder}">
                                <StackPanel>
                                    <TextBlock Text="Gambar Pose Maskot" Foreground="#19D2EF" FontSize="10" FontWeight="Bold" />
                                    <TextBlock Text="Upload gambar pose untuk mengaktifkan Mode Gambar secara otomatis. File disalin ke AppData/REMM-i/poses saat konfigurasi disimpan. Tombol kecil ↔ pada maskot dapat mengubah Mode Gambar kembali ke Bar, atau sebaliknya." Foreground="#7F8D99" FontSize="8" Margin="0,4,0,8" TextWrapping="Wrap" />
                                    <StackPanel Margin="0,2"><TextBlock Text="Idle" Foreground="#DCE5EB" FontSize="8" FontWeight="SemiBold"/><DockPanel Margin="0,2,0,0"><TextBox x:Name="IdlePathText"/><Button Content="Browse" Click="IdleBrowse_Click" DockPanel.Dock="Right" Width="64" Margin="5,0,0,0"/></DockPanel></StackPanel>
                                    <StackPanel Margin="0,8,0,0"><TextBlock Text="Peek" Foreground="#DCE5EB" FontSize="8" FontWeight="SemiBold"/><DockPanel Margin="0,2,0,0"><TextBox x:Name="PeekPathText"/><Button Content="Browse" Click="PeekBrowse_Click" DockPanel.Dock="Right" Width="64" Margin="5,0,0,0"/></DockPanel></StackPanel>
                                    <StackPanel Margin="0,8,0,0"><TextBlock Text="Pointing" Foreground="#DCE5EB" FontSize="8" FontWeight="SemiBold"/><DockPanel Margin="0,2,0,0"><TextBox x:Name="PointingPathText"/><Button Content="Browse" Click="PointingBrowse_Click" DockPanel.Dock="Right" Width="64" Margin="5,0,0,0"/></DockPanel></StackPanel>
                                    <StackPanel Margin="0,8,0,0"><TextBlock Text="Alert" Foreground="#DCE5EB" FontSize="8" FontWeight="SemiBold"/><DockPanel Margin="0,2,0,0"><TextBox x:Name="AlertPathText"/><Button Content="Browse" Click="AlertBrowse_Click" DockPanel.Dock="Right" Width="64" Margin="5,0,0,0"/></DockPanel></StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="SoundSection" Visibility="Collapsed">
                        <Border Style="{StaticResource SectionBorder}">
                            <StackPanel>
                                <DockPanel><TextBlock Text="Suara &amp; Notifikasi" Foreground="#19D2EF" FontSize="10" FontWeight="Bold"/><TextBlock Text="●" DockPanel.Dock="Right" Foreground="#19D2EF" FontSize="11"/></DockPanel>
                                <CheckBox x:Name="NotificationsCheck" Content="Notifikasi Desktop" IsChecked="True" Margin="0,9,0,5" />
                                <CheckBox x:Name="NotificationSoundCheck" Content="Aktifkan suara notifikasi" IsChecked="True" />
                                <DockPanel Margin="0,2,0,0"><TextBlock Text="Master Volume" Foreground="#7F8D99" FontSize="8"/><TextBlock Text="75%" DockPanel.Dock="Right" Foreground="#19D2EF" FontSize="8"/></DockPanel>
                                <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="75" />
                                <TextBlock Text="Parameter Notifikasi Deadline H-Jam" Foreground="#19D2EF" FontSize="9" FontWeight="Bold" Margin="0,5,0,0" />
                                <DockPanel Margin="0,4,0,0"><TextBox x:Name="LeadMinutesText" Text="5" Width="52"/><TextBlock Text=" Jam Sebelum Batas Waktu" Foreground="#B6C1C9" FontSize="8" VerticalAlignment="Center" Margin="7,0,0,0"/></DockPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SectionBorder}">
                            <StackPanel>
                                <TextBlock Text="Tipe Audio Notifikasi" Foreground="#B6C1C9" FontSize="8" FontWeight="SemiBold" />
                                <ComboBox x:Name="SoundCombo" Margin="0,5,0,0">
                                    <ComboBoxItem Content="Synth Chimes (Web Audio)" IsSelected="True" />
                                    <ComboBoxItem Content="Custom Audio File / URL" />
                                </ComboBox>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SectionBorder}">
                            <StackPanel><TextBlock Text="Popup &amp; Perilaku" Foreground="#19D2EF" FontSize="10" FontWeight="Bold"/><CheckBox Content="Popup otomatis ketika ada reminder" IsChecked="True" Margin="0,9,0,5"/><CheckBox Content="Bunyikan alert saat tugas penting jatuh tempo" IsChecked="True" /></StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="DataSection" Visibility="Collapsed">
                        <Border Style="{StaticResource SectionBorder}">
                            <StackPanel>
                                <DockPanel><TextBlock Text="Integrasi EDLINK / AKUN" Foreground="#19D2EF" FontSize="10" FontWeight="Bold"/><CheckBox IsChecked="True" IsEnabled="False" DockPanel.Dock="Right" Margin="0"/></DockPanel>
                                <TextBlock Text="Otomatis sinkronisasi tugas, kalender, dan deadline tugas ke layanan eksternal." Foreground="#7F8D99" FontSize="8" Margin="0,4,0,7" TextWrapping="Wrap" />
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox x:Name="IntegrationUrlText" Text="https://akundev.local/api" Margin="0,0,3,0"/><TextBox x:Name="IntegrationTokenText" Grid.Column="1" Margin="3,0,0,0" /></Grid>
                                <Button Content="↻  Uji Sinkronisasi EDLINK" Click="TestIntegration_Click" HorizontalAlignment="Right" Margin="0,7,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SectionBorder}">
                            <StackPanel>
                                <TextBlock Text="GOOGLE CALENDAR API" Foreground="#19D2EF" FontSize="10" FontWeight="Bold" />
                                <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox x:Name="GoogleApiKeyText" Margin="0,0,3,0"/><TextBox x:Name="GoogleCalendarIdText" Text="primary" Grid.Column="1" Margin="3,0,0,0"/></Grid>
                                <Button Content="↻  Uji Sinkronisasi Calendar" Click="TestCalendar_Click" HorizontalAlignment="Right" Margin="0,7,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SectionBorder}">
                            <StackPanel>
                                <TextBlock Text="Cadangan &amp; Pemulihan Data (Backup JSON)" Foreground="#19D2EF" FontSize="10" FontWeight="Bold" />
                                <TextBlock Text="Ekspor seluruh data tugas, rutinitas, jadwal kalender, dan preferensi Anda ke file JSON; atau pulihkan data dari file cadangan." Foreground="#7F8D99" FontSize="8" Margin="0,4,0,7" TextWrapping="Wrap" />
                                <WrapPanel><Button Content="⇩  Ekspor Data (Backup)" Click="Export_Click" Margin="1,0,2,0"/><Button Content="↥  Impor Data (Restore)" Click="Import_Click" Margin="2,0,1,0"/></WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SectionBorder}">
                            <StackPanel>
                                <TextBlock Text="SQLite Query Simulator" Foreground="#19D2EF" FontSize="10" FontWeight="Bold" />
                                <DockPanel Margin="0,6,0,0"><TextBox x:Name="SqlText" Text="SELECT * FROM tasks"/><Button Content="Run SQL" Click="RunSql_Click" DockPanel.Dock="Right" Margin="5,0,0,0" /></DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="3" BorderBrush="#252B32" BorderThickness="1,0,0,0" Padding="0,8,0,10" Margin="11,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Batal" Click="Close_Click" Margin="2" Padding="10,5" />
                    <Button Content="Simpan Konfigurasi" Click="Save_Click" Background="#19CBE8" Foreground="#061015" BorderBrush="#19CBE8" FontWeight="Bold" Margin="2" Padding="12,5" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
