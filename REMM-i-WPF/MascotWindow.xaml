<Window x:Class="RemmI.MascotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="96" Height="96"
        MinWidth="24" MinHeight="96"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="True"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Grid x:Name="MascotSurface"
          Background="Transparent"
          ClipToBounds="True"
          PreviewMouseLeftButtonDown="MascotSurface_PreviewMouseLeftButtonDown"
          PreviewMouseMove="MascotSurface_PreviewMouseMove"
          PreviewMouseLeftButtonUp="MascotSurface_PreviewMouseLeftButtonUp"
          MouseEnter="MascotSurface_MouseEnter"
          MouseLeave="MascotSurface_MouseLeave">
        <Image x:Name="MascotImage"
               Source="pack://application:,,,/Assets/mascot.png"
               Stretch="Uniform"
               IsHitTestVisible="False"
               RenderTransformOrigin="0.5,0.5" />
        <Border x:Name="BarVisual"
                Visibility="Collapsed"
                Margin="5,5,7,5"
                Background="#E626343E"
                BorderBrush="#FFEF9FB8"
                BorderThickness="1"
                CornerRadius="9"
                IsHitTestVisible="False" />
        <Button x:Name="ModeButton"
                Width="22" Height="22"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,1,1"
                Padding="0"
                Background="#B8111C22"
                BorderBrush="#FFFFC8DB"
                BorderThickness="1"
                Foreground="#FFFFE1EC"
                FontSize="14"
                FontWeight="Bold"
                Content="↔"
                ToolTip="Ganti mode maskot"
                Click="ModeButton_Click" />
    </Grid>
</Window>
