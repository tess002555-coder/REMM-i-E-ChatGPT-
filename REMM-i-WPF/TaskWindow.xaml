<Window x:Class="RemmI.TaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" Height="720"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#F00F172A"
        AllowsTransparency="True">
    <Border Margin="0" CornerRadius="20" Background="#F00F172A" BorderBrush="#3F94A3B8" BorderThickness="1">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel>
                    <TextBlock Text="REMEMBER ME" Foreground="#FF67E8F9" FontSize="11" FontWeight="Bold" />
                    <TextBlock Text="Task Panel" Foreground="#FFF1F5F9" FontSize="28" FontWeight="SemiBold" Margin="0,6,0,0" />
                </StackPanel>
                <Button Width="38" Height="38" HorizontalAlignment="Right" Content="×"
                        FontSize="25" Foreground="White" Background="#1AFFFFFF" BorderThickness="0"
                        Click="Close_Click" Cursor="Hand" />
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,22,0,0">
                <Border Background="#E61E293B" CornerRadius="16" Padding="18">
                    <StackPanel>
                        <TextBlock Text="REMM(i) aktif" Foreground="#FFF1F5F9" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Mascot dapat dipindahkan dan otomatis menempel ke sisi layar terdekat." Foreground="#FF94A3B8" FontSize="13" TextWrapping="Wrap" Margin="0,7,0,0" />
                    </StackPanel>
                </Border>

                <Border Background="#B30F172A" CornerRadius="12" Padding="16" Margin="0,18,0,0">
                    <StackPanel>
                        <TextBlock Text="Tugas" Foreground="#FFF1F5F9" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Belum ada tugas. Tambahkan fitur task setelah window dasar stabil." Foreground="#FF94A3B8" FontSize="13" TextWrapping="Wrap" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</Window>
