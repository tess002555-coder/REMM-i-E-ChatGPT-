<Window x:Class="RemmI.TaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Width="242" Height="448"
        MinWidth="242" MinHeight="448" MaxWidth="242" MaxHeight="448"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="False" ShowActivated="True"
        Background="Transparent" AllowsTransparency="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Border Margin="2" CornerRadius="22" Background="#18181C" BorderBrush="#00A8B5" BorderThickness="1">
        <wv2:WebView2 x:Name="WebView" DefaultBackgroundColor="#18181C"/>
    </Border>
</Window>