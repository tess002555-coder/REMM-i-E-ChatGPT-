<Window x:Class="RemmI.TaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="242" Height="448"
        MinWidth="242" MinHeight="448" MaxWidth="242" MaxHeight="448"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="False" ShowActivated="True"
        Background="Transparent" AllowsTransparency="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="3,0,0,0"/><Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="#DDEAF0"/><Setter Property="Background" Value="#20252C"/>
            <Setter Property="BorderBrush" Value="#39414B"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Height" Value="27"/><Setter Property="MinWidth" Value="27"/>
            <Setter Property="Padding" Value="6,0"/><Setter Property="Foreground" Value="#061015"/>
            <Setter Property="Background" Value="#19CBE8"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Height" Value="27"/><Setter Property="Padding" Value="6,0"/>
            <Setter Property="Margin" Value="4,0,0,0"/><Setter Property="Foreground" Value="#C7D2DA"/>
            <Setter Property="Background" Value="#20242A"/><Setter Property="BorderBrush" Value="#3A424C"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="7.5"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="FilterButton" TargetType="Button">
            <Setter Property="Height" Value="21"/><Setter Property="Padding" Value="5,0"/>
            <Setter Property="Margin" Value="0,0,4,0"/><Setter Property="Foreground" Value="#C8D2DA"/>
            <Setter Property="Background" Value="#20242A"/><Setter Property="BorderBrush" Value="#353D47"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="8"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#171B21"/><Setter Property="Foreground" Value="#E8F6FA"/>
            <Setter Property="BorderBrush" Value="#303842"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,0"/><Setter Property="FontSize" Value="8.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border x:Name="PanelRoot" Margin="2" CornerRadius="22" Background="#F521181E" BorderBrush="#F39BB8" BorderThickness="1"
            PreviewMouseLeftButtonDown="Panel_PreviewMouseLeftButtonDown">
        <Grid Margin="8,6,8,6">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

            <Border Grid.Row="0" HorizontalAlignment="Center" Padding="8,2" Margin="0,0,0,4" CornerRadius="9" Background="#273344" BorderBrush="#3B4B62" BorderThickness="1" Cursor="SizeAll">
                <TextBlock Text="•••  Pindah Panel" Foreground="#AFC0CF" FontSize="7" FontWeight="SemiBold"/>
            </Border>

            <Grid Grid.Row="1" Margin="1,0,1,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="31" Height="31" CornerRadius="16" Background="#11151A" BorderBrush="#F39BB8" BorderThickness="1">
                        <Image Source="/Assets/mascot.png" Width="29" Height="29" Stretch="Uniform" IsHitTestVisible="False"/>
                    </Border>
                    <StackPanel Margin="5,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="REMM(i)E" Foreground="#F8FAFC" FontSize="10.5" FontWeight="Bold"/>
                        <TextBlock x:Name="DisplayNameText" Text="Maskot Denia" Foreground="#67E8F9" FontSize="7" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" Content="⚙" Click="Settings_Click" ToolTip="Pengaturan"/>
                    <Button Style="{StaticResource IconButton}" Content="×" Click="Close_Click" ToolTip="Tutup"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" Height="30" CornerRadius="9" Background="#171B21" BorderBrush="#303842" BorderThickness="1" Margin="1,0,1,5">
                <Grid><TextBlock Text="⌕" Foreground="#758290" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="SearchBox" Margin="24,0,4,0" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" ToolTip="Cari tugas atau rutinitas"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" Focusable="False">
                <StackPanel Margin="1,0,1,1">
                    <Border x:Name="CalendarCard" Padding="7" Margin="0,0,0,5" CornerRadius="11" Background="#29252C" BorderBrush="#3A414B" BorderThickness="1" MouseLeftButtonUp="CalendarCard_Click">
                        <StackPanel>
                            <Grid Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="▣" Foreground="#19CBE8" FontSize="10" Margin="0,0,5,0"/><TextBlock Text="Calender" Foreground="#F7FAFC" FontSize="10.5" FontWeight="Bold"/></StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Style="{StaticResource AccentButton}" Content="+" Click="AddCalendar_Click"/><Button Style="{StaticResource GhostButton}" Content="Detail ›" Click="CalendarDetail_Click"/></StackPanel>
                            </Grid>
                            <Border Padding="6" CornerRadius="8" Background="#171A1F" BorderBrush="#303842" BorderThickness="1"><StackPanel x:Name="CalendarPanel"/></Border>
                        </StackPanel>
                    </Border>

                    <Border x:Name="RoutineCard" Padding="7" Margin="0,0,0,5" CornerRadius="11" Background="#29252C" BorderBrush="#3A414B" BorderThickness="1" MouseLeftButtonUp="RoutineCard_Click">
                        <StackPanel>
                            <Grid Margin="0,0,0,5"><TextBlock Text="Rutinitas" Foreground="#F7FAFC" FontSize="12" FontWeight="Bold"/><Button Style="{StaticResource AccentButton}" Content="+" HorizontalAlignment="Right" Click="AddRoutine_Click"/></Grid>
                            <Border Padding="6" CornerRadius="8" Background="#171A1F" BorderBrush="#303842" BorderThickness="1"><StackPanel x:Name="RoutinePanel"/></Border>
                        </StackPanel>
                    </Border>

                    <Border x:Name="TaskCard" Padding="7" Margin="0,0,0,2" CornerRadius="11" Background="#29252C" BorderBrush="#3A414B" BorderThickness="1">
                        <StackPanel>
                            <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="Tugas" Foreground="#F7FAFC" FontSize="12" FontWeight="Bold"/><Border Margin="4,0,0,0" Padding="3,1" CornerRadius="6" Background="#14363D"><TextBlock x:Name="TaskCountText" Text="0" Foreground="#19CBE8" FontSize="7.5" FontWeight="Bold"/></Border></StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource AccentButton}" Content="+" Click="AddTask_Click"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Button x:Name="FilterAllButton" Style="{StaticResource FilterButton}" Content="Semua" Click="FilterAll_Click" Background="#19CBE8" Foreground="#061015"/>
                                <Button x:Name="FilterHighButton" Style="{StaticResource FilterButton}" Content="● Tinggi" Click="FilterHigh_Click"/>
                                <Button x:Name="FilterMediumButton" Style="{StaticResource FilterButton}" Content="● Sedang" Click="FilterMedium_Click"/>
                                <Button x:Name="FilterLowButton" Style="{StaticResource FilterButton}" Content="● Rendah" Click="FilterLow_Click"/>
                            </StackPanel>
                            <StackPanel x:Name="TasksPanel"/>
                            <TextBlock x:Name="TaskEmptyText" Text="Tidak ada tugas terdaftar." Foreground="#687481" FontSize="7.5" FontStyle="Italic" HorizontalAlignment="Center" Margin="0,7,0,1"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
