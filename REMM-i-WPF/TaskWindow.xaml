<Window x:Class="RemmI.TaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="340" Height="600"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="True"
        Background="Transparent"
        AllowsTransparency="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="30" /><Setter Property="Height" Value="30" /><Setter Property="Margin" Value="2" />
            <Setter Property="Foreground" Value="#D9F7FF" /><Setter Property="Background" Value="#202329" />
            <Setter Property="BorderBrush" Value="#343B45" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Height" Value="30" /><Setter Property="Padding" Value="10,0" /><Setter Property="Margin" Value="2,0" />
            <Setter Property="Foreground" Value="#071014" /><Setter Property="Background" Value="#22D3EE" /><Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="Bold" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border CornerRadius="9" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Height" Value="30" /><Setter Property="Padding" Value="9,0" /><Setter Property="Margin" Value="2,0" />
            <Setter Property="Foreground" Value="#C7D2DA" /><Setter Property="Background" Value="#202329" /><Setter Property="BorderBrush" Value="#3A414C" />
            <Setter Property="BorderThickness" Value="1" /><Setter Property="FontSize" Value="10" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border CornerRadius="9" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="FilterButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Height" Value="24" /><Setter Property="Padding" Value="8,0" /><Setter Property="FontSize" Value="9" /><Setter Property="Margin" Value="2,0,3,0" />
        </Style>
    </Window.Resources>

    <Border Margin="3" CornerRadius="26" Background="#F2151820" BorderBrush="#343C47" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" HorizontalAlignment="Center" Margin="0,8,0,4" Padding="13,4" CornerRadius="10" Background="#253042" BorderBrush="#35455C" BorderThickness="1" Cursor="SizeAll" MouseLeftButtonDown="PanelDragHandle_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal"><TextBlock Text="•••" Foreground="#22D3EE" FontWeight="Bold"/><TextBlock Text="  Pindah Panel" Foreground="#A9B8C5" FontSize="9" Margin="5,0,0,0"/></StackPanel>
            </Border>

            <Grid Grid.Row="1" Margin="12,2,12,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="18" Background="#11151A" BorderBrush="#22D3EE" BorderThickness="1"><Image Source="/Assets/mascot.png" Width="34" Height="34" Stretch="Uniform" IsHitTestVisible="False" /></Border>
                    <StackPanel Margin="8,0,0,0"><TextBlock Text="REMM(i)E" Foreground="#F8FAFC" FontSize="13" FontWeight="Bold" /><TextBlock x:Name="DisplayNameText" Text="Maskot Denia" Foreground="#67E8F9" FontSize="9" /></StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource IconButton}" Content="↓" Click="Download_Click" ToolTip="Backup data" />
                    <Button Style="{StaticResource IconButton}" Content="⚙" Click="Settings_Click" ToolTip="Pengaturan" />
                    <Button Style="{StaticResource IconButton}" Content="▣" Click="Layout_Click" ToolTip="Tampilan" />
                    <Button Style="{StaticResource IconButton}" Content=">_" Click="Console_Click" ToolTip="Informasi data" />
                    <Button Style="{StaticResource IconButton}" Content="×" Click="Close_Click" ToolTip="Tutup menu" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" Margin="12,0,12,10" Height="38" CornerRadius="12" Background="#181C22" BorderBrush="#303742" BorderThickness="1">
                <Grid><TextBlock Text="⌕" Foreground="#71808E" FontSize="15" Margin="11,0,0,0" VerticalAlignment="Center"/><TextBox x:Name="SearchBox" Margin="30,0,8,0" VerticalContentAlignment="Center" Background="Transparent" Foreground="#E5E7EB" BorderThickness="0" FontSize="10.5" TextChanged="SearchBox_TextChanged" ToolTip="Cari tugas atau rutinitas" /></Grid>
            </Border>

            <Border Grid.Row="3" Margin="12,0,12,8" Padding="10" CornerRadius="15" Background="#25282F" BorderBrush="#343C47" BorderThickness="1">
                <StackPanel>
                    <Grid Margin="0,0,0,7"><StackPanel Orientation="Horizontal"><TextBlock Text="◫" Foreground="#22D3EE" FontSize="16" Margin="0,0,7,0"/><TextBlock Text="Calender" Foreground="#F8FAFC" FontSize="14" FontWeight="Bold" /></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource AccentButton}" Width="30" Content="+" Click="AddCalendar_Click" /><Button Style="{StaticResource GhostButton}" Width="68" Content="Detail ›" Click="CalendarDetail_Click" /></StackPanel></Grid>
                    <Border Padding="9" CornerRadius="11" Background="#171A1F" BorderBrush="#303742" BorderThickness="1"><StackPanel x:Name="CalendarPanel" /></Border>
                </StackPanel>
            </Border>

            <Border Grid.Row="4" Margin="12,0,12,8" Padding="10" CornerRadius="15" Background="#25282F" BorderBrush="#343C47" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid><TextBlock Text="Rutinitas" Foreground="#F8FAFC" FontSize="14" FontWeight="Bold"/><Button Style="{StaticResource AccentButton}" Width="30" Content="+" HorizontalAlignment="Right" Click="AddRoutine_Click" /></Grid>
                    <Border Grid.Row="1" Padding="9" CornerRadius="11" Background="#171A1F" BorderBrush="#303742" BorderThickness="1" Margin="0,7,0,0"><StackPanel x:Name="RoutinePanel" /></Border>
                </Grid>
            </Border>

            <Border Grid.Row="5" Margin="12,0,12,10" Padding="10" CornerRadius="15" Background="#25282F" BorderBrush="#343C47" BorderThickness="1">
                <StackPanel>
                    <Grid Margin="0,0,0,7"><StackPanel Orientation="Horizontal"><TextBlock Text="Tugas" Foreground="#F8FAFC" FontSize="14" FontWeight="Bold"/><Border Margin="6,0,0,0" Padding="5,1" CornerRadius="7" Background="#12343B"><TextBlock Text="0" Foreground="#22D3EE" FontSize="8" /></Border></StackPanel><Button Style="{StaticResource AccentButton}" Width="30" Content="+" HorizontalAlignment="Right" Click="AddTask_Click" /></Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,7"><Button Style="{StaticResource FilterButton}" Content="Semua" Click="FilterAll_Click" Background="#22D3EE" Foreground="#071014"/><Button Style="{StaticResource FilterButton}" Content="● Tinggi" Click="FilterHigh_Click"/><Button Style="{StaticResource FilterButton}" Content="● Sedang" Click="FilterMedium_Click"/><Button Style="{StaticResource FilterButton}" Content="● Rendah" Click="FilterLow_Click"/></StackPanel>
                    <StackPanel x:Name="TasksPanel"/><TextBlock x:Name="TaskEmptyText" Text="Tidak ada tugas terdaftar." Foreground="#64707C" FontSize="10" FontStyle="Italic" HorizontalAlignment="Center" Margin="0,10,0,2" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
