<Window x:Class="RemmI.TaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="225" Height="430"
        MinWidth="225" MinHeight="430" MaxWidth="225" MaxHeight="430"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="False" ShowActivated="True"
        Background="Transparent" AllowsTransparency="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI">

    <Window.Resources>
        <DropShadowEffect x:Key="PanelShadow"
                          BlurRadius="30"
                          ShadowDepth="8"
                          Direction="270"
                          Opacity="0.28"
                          Color="#000000"/>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="#AAB1BD"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#2F3036"/>
            <Setter Property="BorderBrush" Value="#454750"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="9"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Width" Value="25"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="#182026"/>
            <Setter Property="Background" Value="#12BBD8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="8"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="0,-1,0,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DetailButton" TargetType="Button">
            <Setter Property="Height" Value="25"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Foreground" Value="#12BBD8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="8.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="8"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterButton" TargetType="Button">
            <Setter Property="Height" Value="21"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Foreground" Value="#B7BCC5"/>
            <Setter Property="Background" Value="#25262C"/>
            <Setter Property="BorderBrush" Value="#3D3F47"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D5D8DE"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border x:Name="PanelRoot"
            Margin="2"
            CornerRadius="22"
            Background="#28292F"
            BorderBrush="#3E4048"
            BorderThickness="1"
            Effect="{DynamicResource PanelShadow}"
            PreviewMouseLeftButtonDown="Panel_PreviewMouseLeftButtonDown">

        <Grid Margin="10,0,10,9">
            <Grid.RowDefinitions>
                <RowDefinition Height="25"/>
                <RowDefinition Height="45"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- DRAG HANDLE -->
            <Border Grid.Row="0"
                    Width="82"
                    Height="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,0,0,0"
                    CornerRadius="10"
                    Background="#343C4C"
                    BorderBrush="#46556B"
                    BorderThickness="1"
                    Cursor="SizeAll">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="•••"
                               Foreground="#72A0C6"
                               FontSize="6.5"
                               FontWeight="Bold"
                               Margin="0,-1,6,0"/>
                    <TextBlock Text="Pindah Panel"
                               Foreground="#A9B8C8"
                               FontSize="6.5"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- HEADER -->
            <Grid Grid.Row="1" Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Ellipse Width="25"
                         Height="25"
                         VerticalAlignment="Center"
                         Clip="M 0,0 L 31,0 L 31,31 L 0,31 Z">
                    <Ellipse.Fill>
                        <ImageBrush ImageSource="/Assets/mascot.png"
                                    Stretch="UniformToFill"/>
                    </Ellipse.Fill>
                </Ellipse>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="7,0,0,0">
                    <TextBlock Text="REMM(i)E"
                               Foreground="#F3F4F6"
                               FontSize="10.5"
                               FontWeight="Bold"/>
                    <TextBlock x:Name="DisplayNameText"
                               Text="Maskot Denia"
                               Foreground="#12BBD8"
                               FontSize="8"
                               FontWeight="SemiBold"
                               Margin="0,1,0,0"/>
                    <TextBlock x:Name="TodayText"
                               Text="Hari ini"
                               Foreground="#727783"
                               FontSize="6"
                               Visibility="Collapsed"/>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}"
                            Content="⚙"
                            Click="Settings_Click"
                            ToolTip="Pengaturan"/>
                    <Button Style="{StaticResource IconButton}"
                            Content="×"
                            Click="Close_Click"
                            ToolTip="Tutup"/>
                </StackPanel>
            </Grid>

            <!-- SEARCH -->
            <Border Grid.Row="2"
                    Height="28"
                    CornerRadius="14"
                    Background="#292A30"
                    BorderBrush="#484A53"
                    BorderThickness="1"
                    VerticalAlignment="Center">
                <Grid>
                    <TextBlock Text="⌕"
                               Foreground="#9196A2"
                               FontSize="7"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="SearchPlaceholder"
                               Text="Cari tugas / rutinitas..."
                               Foreground="#7C808B"
                               FontSize="7.5"
                               Margin="27,0,8,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                    <TextBox x:Name="SearchBox"
                             Style="{StaticResource SearchBoxStyle}"
                             Margin="27,0,9,0"
                             VerticalContentAlignment="Center"
                             TextChanged="SearchBox_TextChanged"/>
                </Grid>
            </Border>

            <!-- CALENDAR -->
            <Border x:Name="CalendarCard"
                    Grid.Row="3"
                    Padding="8"
                    Margin="0,0,0,6"
                    CornerRadius="16"
                    Background="#36373D"
                    BorderBrush="#4B4D55"
                    BorderThickness="1"
                    MouseLeftButtonUp="CalendarCard_Click">

                <StackPanel>
                    <Border Height="30"
                            CornerRadius="11"
                            Background="#414249"
                            BorderBrush="#52545D"
                            BorderThickness="1">
                        <Grid Margin="8,0,6,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="▣"
                                           Foreground="#12BBD8"
                                           FontSize="12"
                                           Margin="0,0,9,0"/>
                                <TextBlock Text="Calender"
                                           Foreground="#F0F1F3"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Style="{StaticResource AccentButton}"
                                    Content="+"
                                    Click="AddCalendar_Click"
                                    Margin="0,0,5,0"/>

                            <Button Grid.Column="2"
                                    Style="{StaticResource DetailButton}"
                                    Content="Detail  ›"
                                    Click="CalendarDetail_Click"/>
                        </Grid>
                    </Border>

                    <Border Padding="8,6"
                            Margin="0,9,0,0"
                            CornerRadius="11"
                            Background="#2B2C31"
                            BorderBrush="#464850"
                            BorderThickness="1">
                        <StackPanel x:Name="CalendarPanel"/>
                    </Border>

                    <TextBlock x:Name="CalendarCountText"
                               Text="0 acara tersimpan"
                               Foreground="#707580"
                               FontSize="7"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- ROUTINE -->
            <Border x:Name="RoutineCard"
                    Grid.Row="4"
                    Padding="12"
                    Margin="0,0,0,10"
                    CornerRadius="16"
                    Background="#36373D"
                    BorderBrush="#4B4D55"
                    BorderThickness="1"
                    MouseLeftButtonUp="RoutineCard_Click">

                <StackPanel>
                    <Border Height="42"
                            CornerRadius="11"
                            Background="#414249"
                            BorderBrush="#52545D"
                            BorderThickness="1">
                        <Grid Margin="11,0,8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Rutinitas"
                                       Foreground="#F0F1F3"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>

                            <Button Grid.Column="1"
                                    Style="{StaticResource AccentButton}"
                                    Content="+"
                                    HorizontalAlignment="Right"
                                    Click="AddRoutine_Click"/>
                        </Grid>
                    </Border>

                    <Border Padding="7"
                            Margin="0,9,0,0"
                            CornerRadius="11"
                            Background="#2B2C31"
                            BorderBrush="#464850"
                            BorderThickness="1">
                        <StackPanel x:Name="RoutinePanel"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- TASKS -->
            <Border x:Name="TaskCard"
                    Grid.Row="5"
                    Padding="12"
                    CornerRadius="16"
                    Background="#36373D"
                    BorderBrush="#4B4D55"
                    BorderThickness="1">

                <StackPanel>
                    <Border Height="42"
                            CornerRadius="11"
                            Background="#414249"
                            BorderBrush="#52545D"
                            BorderThickness="1">
                        <Grid Margin="11,0,8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Tugas"
                                           Foreground="#F0F1F3"
                                           FontSize="12"
                                           FontWeight="Bold"/>
                                <Border Width="16"
                                        Height="16"
                                        CornerRadius="8"
                                        Background="#1C7788"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="TaskCountText"
                                               Text="0"
                                               Foreground="#9DE8F3"
                                               FontSize="7"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Style="{StaticResource AccentButton}"
                                    Content="+"
                                    HorizontalAlignment="Right"
                                    Click="AddTask_Click"/>
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,8,0,7">
                        <Button x:Name="FilterAllButton"
                                Style="{StaticResource FilterButton}"
                                Content="Semua"
                                Click="FilterAll_Click"
                                Background="#12BBD8"
                                Foreground="#122126"
                                BorderBrush="#12BBD8"/>
                        <Button x:Name="FilterHighButton"
                                Style="{StaticResource FilterButton}"
                                Content="● Tinggi"
                                Click="FilterHigh_Click"/>
                        <Button x:Name="FilterMediumButton"
                                Style="{StaticResource FilterButton}"
                                Content="● Sedang"
                                Click="FilterMedium_Click"/>
                        <Button x:Name="FilterLowButton"
                                Style="{StaticResource FilterButton}"
                                Content="● Rendah"
                                Click="FilterLow_Click"
                                Margin="0"/>
                    </StackPanel>

                    <StackPanel x:Name="TasksPanel"
                                 Margin="2,0,2,0"/>

                    <TextBlock x:Name="TaskEmptyText"
                               Text="Tidak ada tugas terdaftar."
                               Foreground="#777A84"
                               FontSize="9"
                               FontStyle="Italic"
                               HorizontalAlignment="Center"
                               Margin="4,10,4,3"/>
                    <TextBlock x:Name="SummaryText"
                               Text="0 tugas aktif"
                               Visibility="Collapsed"/>
                    <TextBlock x:Name="NextEventText"
                               Text="Tidak ada agenda berikutnya"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>