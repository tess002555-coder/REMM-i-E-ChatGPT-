<Window x:Class="RemmI.TaskWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="330" Height="590" MinWidth="330" MinHeight="590" MaxWidth="330" MaxHeight="590" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="True" Background="Transparent" AllowsTransparency="True" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="IconButton" TargetType="Button"><Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="Margin" Value="3,0,0,0"/><Setter Property="Foreground" Value="#DDF9FF"/><Setter Property="Background" Value="#20242B"/><Setter Property="BorderBrush" Value="#353B45"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/></Style>
        <Style x:Key="AccentButton" TargetType="Button"><Setter Property="Height" Value="30"/><Setter Property="MinWidth" Value="30"/><Setter Property="Padding" Value="9,0"/><Setter Property="Foreground" Value="#061015"/><Setter Property="Background" Value="#22D3EE"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Cursor" Value="Hand"/></Style>
        <Style x:Key="GhostButton" TargetType="Button"><Setter Property="Height" Value="30"/><Setter Property="Padding" Value="9,0"/><Setter Property="Margin" Value="4,0,0,0"/><Setter Property="Foreground" Value="#C8D2DA"/><Setter Property="Background" Value="#20242A"/><Setter Property="BorderBrush" Value="#3A414B"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="9.5"/><Setter Property="Cursor" Value="Hand"/></Style>
        <Style x:Key="FilterButton" TargetType="Button" BasedOn="{StaticResource GhostButton}"><Setter Property="Height" Value="23"/><Setter Property="Padding" Value="7,0"/><Setter Property="FontSize" Value="8.5"/><Setter Property="Margin" Value="0,0,4,0"/></Style>
        <Style TargetType="TextBox"><Setter Property="Background" Value="#171A20"/><Setter Property="Foreground" Value="#E8F7FC"/><Setter Property="BorderBrush" Value="#303742"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="8,0"/><Setter Property="FontSize" Value="10"/></Style>
    </Window.Resources>
    <Border x:Name="PanelRoot" Margin="2" CornerRadius="25" Background="#F5111419" BorderBrush="#343C47" BorderThickness="1" PreviewMouseLeftButtonDown="Panel_PreviewMouseLeftButtonDown">
        <Grid Margin="11">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" HorizontalAlignment="Center" Padding="12,4" Margin="0,0,0,7" CornerRadius="10" Background="#253044" BorderBrush="#35455C" BorderThickness="1" Cursor="SizeAll"><TextBlock Text="•••  Pindah Panel" Foreground="#AFC0CF" FontSize="9" FontWeight="SemiBold"/></Border>
            <Grid Grid.Row="1" Margin="1,0,1,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="38" Height="38" CornerRadius="19" Background="#11151A" BorderBrush="#22D3EE" BorderThickness="1"><Image Source="/Assets/mascot.png" Width="36" Height="36" Stretch="Uniform" IsHitTestVisible="False"/></Border><StackPanel Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock Text="REMM(i)E" Foreground="#F8FAFC" FontSize="13" FontWeight="Bold"/><TextBlock x:Name="DisplayNameText" Text="Maskot Denia" Foreground="#67E8F9" FontSize="9" FontWeight="SemiBold"/></StackPanel></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Style="{StaticResource IconButton}" Content="⚙" Click="Settings_Click" ToolTip="Pengaturan"/><Button Style="{StaticResource IconButton}" Content="⋯" Click="Console_Click" ToolTip="Info data"/><Button Style="{StaticResource IconButton}" Content="×" Click="Close_Click" ToolTip="Tutup"/></StackPanel></Grid>
            <Border Grid.Row="2" Height="38" CornerRadius="11" Background="#181C22" BorderBrush="#303742" BorderThickness="1" Margin="1,0,1,10"><Grid><TextBlock Text="⌕" Foreground="#758290" FontSize="16" Margin="10,0,0,0" VerticalAlignment="Center"/><TextBox x:Name="SearchBox" Margin="29,0,6,0" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" ToolTip="Cari tugas atau rutinitas"/></Grid></Border>
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="1,0,1,2">
                <Border x:Name="CalendarCard" Padding="10" Margin="0,0,0,9" CornerRadius="15" Background="#25282F" BorderBrush="#343C47" BorderThickness="1" MouseLeftButtonUp="CalendarCard_Click"><StackPanel><Grid Margin="0,0,0,8"><StackPanel Orientation="Horizontal"><TextBlock Text="▣" Foreground="#22D3EE" FontSize="14" Margin="0,0,7,0"/><TextBlock Text="Calender" Foreground="#F8FAFC" FontSize="14" FontWeight="Bold"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource AccentButton}" Content="+" Click="AddCalendar_Click"/><Button Style="{StaticResource GhostButton}" Content="Detail ›" Click="CalendarDetail_Click"/></StackPanel></Grid><Border Padding="9" CornerRadius="11" Background="#171A1F" BorderBrush="#303742" BorderThickness="1"><StackPanel x:Name="CalendarPanel"/></Border></StackPanel></Border>
                <Border x:Name="RoutineCard" Padding="10" Margin="0,0,0,9" CornerRadius="15" Background="#25282F" BorderBrush="#343C47" BorderThickness="1" MouseLeftButtonUp="RoutineCard_Click"><StackPanel><Grid Margin="0,0,0,8"><TextBlock Text="Rutinitas" Foreground="#F8FAFC" FontSize="14" FontWeight="Bold"/><Button Style="{StaticResource AccentButton}" Content="+" HorizontalAlignment="Right" Click="AddRoutine_Click"/></Grid><Border Padding="9" CornerRadius="11" Background="#171A1F" BorderBrush="#303742" BorderThickness="1"><StackPanel x:Name="RoutinePanel"/></Border></StackPanel></Border>
                <Border x:Name="TaskCard" Padding="10" Margin="0,0,0,4" CornerRadius="15" Background="#25282F" BorderBrush="#343C47" BorderThickness="1"><StackPanel><Grid Margin="0,0,0,7"><StackPanel Orientation="Horizontal"><TextBlock Text="Tugas" Foreground="#F8FAFC" FontSize="14" FontWeight="Bold"/><Border Margin="6,0,0,0" Padding="5,1" CornerRadius="7" Background="#12343B"><TextBlock x:Name="TaskCountText" Text="0" Foreground="#22D3EE" FontSize="8" FontWeight="Bold"/></Border></StackPanel><Button Style="{StaticResource AccentButton}" Content="+" HorizontalAlignment="Right" Click="AddTask_Click"/></Grid><StackPanel Orientation="Horizontal" Margin="0,0,0,8"><Button x:Name="FilterAllButton" Style="{StaticResource FilterButton}" Content="Semua" Click="FilterAll_Click" Background="#22D3EE" Foreground="#061015"/><Button x:Name="FilterHighButton" Style="{StaticResource FilterButton}" Content="● Tinggi" Click="FilterHigh_Click"/><Button x:Name="FilterMediumButton" Style="{StaticResource FilterButton}" Content="● Sedang" Click="FilterMedium_Click"/><Button x:Name="FilterLowButton" Style="{StaticResource FilterButton}" Content="● Rendah" Click="FilterLow_Click"/></StackPanel><StackPanel x:Name="TasksPanel"/><TextBlock x:Name="TaskEmptyText" Text="Tidak ada tugas terdaftar." Foreground="#687481" FontSize="9.5" FontStyle="Italic" HorizontalAlignment="Center" Margin="0,8,0,2"/></StackPanel></Border>
            </StackPanel></ScrollViewer>
        </Grid>
    </Border>
</Window>
