<Window x:Class="RemmI.TaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="360" Height="620"
        MinWidth="360" MinHeight="620" MaxWidth="360" MaxHeight="620"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="False" ShowActivated="True"
        Background="Transparent" AllowsTransparency="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI">
    <Window.Resources>
        <DropShadowEffect x:Key="PanelShadow" BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.48" Color="#000000"/>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="4,0,0,0"/><Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="#B8C7D3"/><Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#18222A"/><Setter Property="BorderBrush" Value="#2B3944"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Border CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/><Setter Property="Foreground" Value="#061015"/>
            <Setter Property="Background" Value="#F39BB8"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Border CornerRadius="10" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Height" Value="27"/><Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0,0,6,0"/><Setter Property="Foreground" Value="#B8C7D3"/>
            <Setter Property="Background" Value="#18222A"/><Setter Property="BorderBrush" Value="#2B3944"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="8.5"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Border CornerRadius="14" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterButton" TargetType="Button">
            <Setter Property="Height" Value="24"/><Setter Property="Padding" Value="9,0"/>
            <Setter Property="Margin" Value="0,0,5,0"/><Setter Property="Foreground" Value="#AEBBC5"/>
            <Setter Property="Background" Value="#18222A"/><Setter Property="BorderBrush" Value="#2B3944"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="8"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Border CornerRadius="12" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="Height" Value="34"/><Setter Property="Padding" Value="10,0"/>
            <Setter Property="Foreground" Value="#DCE8EF"/><Setter Property="Background" Value="#152029"/>
            <Setter Property="BorderBrush" Value="#2C3D49"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="8.5"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Border CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#ECF7FB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border x:Name="PanelRoot" Margin="3" CornerRadius="26"
            Background="#F00F151B" BorderBrush="#F39BB8" BorderThickness="1"
            Effect="{DynamicResource PanelShadow}"
            PreviewMouseLeftButtonDown="Panel_PreviewMouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0" Padding="18,14,18,13" Background="#141D25" CornerRadius="24,24,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="REMM(i)E" Foreground="#F7FAFC" FontSize="18" FontWeight="Bold"/>
                        <TextBlock x:Name="DisplayNameText" Text="Maskot Denia" Foreground="#F39BB8" FontSize="9" FontWeight="SemiBold" Margin="0,2,0,0"/>
                        <TextBlock x:Name="TodayText" Text="Hari ini" Foreground="#71808C" FontSize="8" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource IconButton}" Content="⚙" Click="Settings_Click" ToolTip="Pengaturan"/>
                        <Button Style="{StaticResource IconButton}" Content="×" Click="Close_Click" ToolTip="Tutup"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- STATUS -->
            <Border Grid.Row="1" Margin="12,12,12,8" Padding="13"
                    CornerRadius="16" Background="#18242D" BorderBrush="#2B3B47" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="PUSAT AKTIVITAS" Foreground="#6BE7F2" FontSize="8" FontWeight="Bold"/>
                        <TextBlock x:Name="SummaryText" Text="0 tugas aktif" Foreground="#F3F7FA" FontSize="14" FontWeight="SemiBold" Margin="0,3,0,0"/>
                        <TextBlock x:Name="NextEventText" Text="Tidak ada agenda berikutnya" Foreground="#81919D" FontSize="8" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="48" Height="48" CornerRadius="24" Background="#3B2430" BorderBrush="#F39BB8" BorderThickness="1">
                        <TextBlock Text="◉" Foreground="#F39BB8" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- SEARCH + QUICK ACTION -->
            <StackPanel Grid.Row="2" Margin="12,0,12,10">
                <Border Height="34" CornerRadius="11" Background="#121A21" BorderBrush="#293742" BorderThickness="1">
                    <Grid>
                        <TextBlock Text="⌕" Foreground="#7D8C98" FontSize="15" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SearchPlaceholder" Text="Cari tugas atau rutinitas..." Foreground="#667682" FontSize="9"
                                   Margin="30,0,5,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <TextBox x:Name="SearchBox" Margin="30,0,8,0" VerticalContentAlignment="Center"
                                 TextChanged="SearchBox_TextChanged"/>
                    </Grid>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Style="{StaticResource CardButton}" Width="104" Content="＋  Tugas Baru" Click="AddTask_Click"/>
                    <Button Style="{StaticResource CardButton}" Width="104" Content="＋  Acara" Click="AddCalendar_Click"/>
                    <Button Style="{StaticResource CardButton}" Width="104" Content="＋  Rutinitas" Click="AddRoutine_Click"/>
                </StackPanel>
            </StackPanel>

            <!-- CONTENT -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="12,0,12,14">
                <StackPanel>
                    <!-- CALENDAR -->
                    <Border x:Name="CalendarCard" Padding="12" Margin="0,0,0,9" CornerRadius="16"
                            Background="#171F27" BorderBrush="#F39BB8" BorderThickness="1"
                            MouseLeftButtonUp="CalendarCard_Click">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="KALENDER" Foreground="#F39BB8" FontSize="8" FontWeight="Bold"/>
                                    <TextBlock x:Name="CalendarCountText" Text="0 acara" Foreground="#71808C" FontSize="8" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource AccentButton}" Content="+" Click="AddCalendar_Click"/>
                                    <Button Style="{StaticResource PillButton}" Content="Lihat semua ›" Click="CalendarDetail_Click"/>
                                </StackPanel>
                            </Grid>
                            <Border Padding="8" CornerRadius="11" Background="#10171D">
                                <StackPanel x:Name="CalendarPanel"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ROUTINE -->
                    <Border x:Name="RoutineCard" Padding="12" Margin="0,0,0,9" CornerRadius="16"
                            Background="#171F27" BorderBrush="#2B3B47" BorderThickness="1"
                            MouseLeftButtonUp="RoutineCard_Click">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="RUTINITAS" Foreground="#6BE7F2" FontSize="8" FontWeight="Bold"/>
                                    <TextBlock Text="Kebiasaan yang sedang berjalan" Foreground="#71808C" FontSize="8" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Style="{StaticResource AccentButton}" Content="+" HorizontalAlignment="Right" Click="AddRoutine_Click"/>
                            </Grid>
                            <Border Padding="8" CornerRadius="11" Background="#10171D">
                                <StackPanel x:Name="RoutinePanel"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- TASKS -->
                    <Border x:Name="TaskCard" Padding="12" CornerRadius="16"
                            Background="#171F27" BorderBrush="#2B3B47" BorderThickness="1">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="TUGAS" Foreground="#F3F7FA" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock x:Name="TaskCountText" Text="0" Foreground="#F39BB8" FontSize="8" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Style="{StaticResource AccentButton}" Content="+" HorizontalAlignment="Right" Click="AddTask_Click"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button x:Name="FilterAllButton" Style="{StaticResource FilterButton}" Content="Semua" Click="FilterAll_Click" Background="#F39BB8" Foreground="#1A1015"/>
                                <Button x:Name="FilterHighButton" Style="{StaticResource FilterButton}" Content="Tinggi" Click="FilterHigh_Click"/>
                                <Button x:Name="FilterMediumButton" Style="{StaticResource FilterButton}" Content="Sedang" Click="FilterMedium_Click"/>
                                <Button x:Name="FilterLowButton" Style="{StaticResource FilterButton}" Content="Rendah" Click="FilterLow_Click"/>
                            </StackPanel>

                            <Border Padding="8" CornerRadius="11" Background="#10171D">
                                <StackPanel x:Name="TasksPanel"/>
                            </Border>
                            <TextBlock x:Name="TaskEmptyText" Text="Belum ada tugas. Tambahkan tugas baru untuk memulai."
                                       Foreground="#687781" FontSize="8" FontStyle="Italic"
                                       HorizontalAlignment="Center" Margin="4,10,4,3" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>