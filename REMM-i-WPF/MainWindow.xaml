<Window x:Class="RemmI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="128" Height="128"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="False"
        ShowActivated="True"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Grid x:Name="MascotSurface"
          Background="Transparent"
          Cursor="Hand"
          MouseEnter="Mascot_MouseEnter"
          MouseLeave="Mascot_MouseLeave"
          PreviewMouseLeftButtonDown="Mascot_MouseLeftButtonDown"
          PreviewMouseMove="Mascot_MouseMove"
          PreviewMouseLeftButtonUp="Mascot_MouseLeftButtonUp">
        <Image Source="/Assets/mascot.png"
               Stretch="Uniform"
               Width="128"
               Height="128"
               IsHitTestVisible="False" />
    </Grid>
</Window>
