<Window x:Class="RemmI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="96" Height="96"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="True"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        MouseEnter="Mascot_MouseEnter"
        MouseLeave="Mascot_MouseLeave"
        PreviewMouseLeftButtonDown="Mascot_MouseLeftButtonDown"
        PreviewMouseMove="Mascot_MouseMove"
        PreviewMouseLeftButtonUp="Mascot_MouseLeftButtonUp">
    <Grid>
        <Border x:Name="BarSurface"
                Background="#15181D"
                BorderBrush="#22D3EE"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.35" />
            </Border.Effect>
        </Border>

        <Image x:Name="MascotImage"
               Stretch="Uniform"
               Width="96"
               Height="96"
               IsHitTestVisible="True" />

        <Button x:Name="ModeToggleButton"
                Width="18"
                Height="18"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,4,4"
                Padding="0"
                Content="↔"
                FontSize="9"
                FontWeight="Bold"
                Background="#15181D"
                Foreground="#22D3EE"
                BorderBrush="#22D3EE"
                BorderThickness="1"
                ToolTip="Ganti mode Bar / Gambar"
                Click="ModeToggleButton_Click" />
    </Grid>
</Window>