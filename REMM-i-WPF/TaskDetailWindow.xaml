<Window x:Class="RemmI.TaskDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="360" Height="390"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        Background="Transparent" AllowsTransparency="True">
    <Border Margin="2" CornerRadius="18" Background="#F5171A20" BorderBrush="#22D3EE" BorderThickness="1" Padding="16">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="● DETAIL TUGAS" Foreground="#22D3EE" FontSize="12" FontWeight="Bold"/>
                    <TextBlock Text="Edit tugas, deadline, prioritas, dan status." Foreground="#71808C" FontSize="8" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Content="×" Width="28" Height="28" HorizontalAlignment="Right" Click="Close_Click" Background="#20242A" Foreground="#DDEAF0" BorderBrush="#343C47"/>
            </Grid>
            <StackPanel Grid.Row="1">
                <TextBlock Text="Nama Tugas" Foreground="#AFC0CF" FontSize="9" Margin="0,0,0,4"/>
                <TextBox x:Name="TitleBox" Height="32" Background="#101216" Foreground="#F8FAFC" BorderBrush="#343C47" Padding="8" Margin="0,0,0,10"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,7,0">
                        <TextBlock Text="Deadline" Foreground="#AFC0CF" FontSize="9" Margin="0,0,0,4"/>
                        <DatePicker x:Name="DateBox" Height="32"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Jam" Foreground="#AFC0CF" FontSize="9" Margin="0,0,0,4"/>
                        <TextBox x:Name="TimeBox" Height="32" Text="09:00" Padding="8"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="Prioritas" Foreground="#AFC0CF" FontSize="9" Margin="0,0,0,4"/>
                <ComboBox x:Name="PriorityBox" Height="32" Margin="0,0,0,10">
                    <ComboBoxItem Content="Tinggi"/><ComboBoxItem Content="Sedang"/><ComboBoxItem Content="Rendah"/>
                </ComboBox>
                <CheckBox x:Name="CompletedCheck" Content="Tugas sudah selesai" Foreground="#DCE5EB" Margin="0,2,0,10"/>
                <TextBlock Text="Catatan" Foreground="#AFC0CF" FontSize="9" Margin="0,0,0,4"/>
                <TextBox x:Name="NotesBox" Height="72" Background="#101216" Foreground="#F8FAFC" BorderBrush="#343C47" Padding="8" TextWrapping="Wrap" AcceptsReturn="True"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Hapus" Width="76" Height="30" Margin="0,0,7,0" Click="Delete_Click" Background="#3A2027" Foreground="#FCA5A5" BorderBrush="#6B303D"/>
                <Button Content="Simpan" Width="92" Height="30" Click="Save_Click" Background="#22D3EE" Foreground="#061015" BorderThickness="0" FontWeight="Bold"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>