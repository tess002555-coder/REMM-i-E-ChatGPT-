<Window x:Class="RemmI.EntryDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="390" Height="430" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" Background="Transparent"
        AllowsTransparency="True" WindowStartupLocation="CenterScreen">
    <Border CornerRadius="20" Background="#18181C" BorderBrush="#00A8B5" BorderThickness="1" Padding="18">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <TextBlock x:Name="TitleText" Foreground="#00D2D3" FontSize="14" FontWeight="Bold"/>
                <Button Content="×" Width="28" Height="28" HorizontalAlignment="Right" Click="Cancel_Click" Background="#222228" Foreground="#DDEAF0" BorderBrush="#353D44"/>
            </Grid>
            <StackPanel Grid.Row="1">
                <TextBlock x:Name="NameLabel" Text="Nama" Foreground="#AAB4BA" FontSize="9" Margin="0,0,0,4"/>
                <TextBox x:Name="NameBox" Height="32" Padding="8" Background="#15151A" Foreground="#F8FAFC" BorderBrush="#353D44" Margin="0,0,0,10"/>
                <TextBlock x:Name="DateLabel" Text="Tanggal &amp; waktu" Foreground="#AAB4BA" FontSize="9" Margin="0,0,0,4"/>
                <DatePicker x:Name="DateBox" Height="32" Background="#15151A" Foreground="#F8FAFC" Margin="0,0,0,10"/>
                <TextBlock x:Name="PriorityLabel" Text="Prioritas" Foreground="#AAB4BA" FontSize="9" Margin="0,0,0,4"/>
                <ComboBox x:Name="PriorityBox" Height="32" Background="#15151A" Foreground="#F8FAFC" Margin="0,0,0,10">
                    <ComboBoxItem Content="Tinggi"/><ComboBoxItem Content="Sedang" IsSelected="True"/><ComboBoxItem Content="Rendah"/>
                </ComboBox>
                <TextBlock x:Name="NotesLabel" Text="Catatan" Foreground="#AAB4BA" FontSize="9" Margin="0,0,0,4"/>
                <TextBox x:Name="NotesBox" Height="48" Padding="8" Background="#15151A" Foreground="#F8FAFC" BorderBrush="#353D44" TextWrapping="Wrap" AcceptsReturn="True"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Batal" Width="76" Height="32" Style="{StaticResource RemmWindowButton}" Margin="0,0,7,0" Click="Cancel_Click" Background="#222228" Foreground="#C8D2DA" BorderBrush="#353D44"/>
                <Button Content="Simpan" Width="96" Height="32" Style="{StaticResource RemmPrimaryButton}" Click="Save_Click" Background="#00D2D3" Foreground="#061015" BorderThickness="0" FontWeight="Bold"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
