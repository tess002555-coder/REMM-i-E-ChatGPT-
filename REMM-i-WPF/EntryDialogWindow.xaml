<Window x:Class="RemmI.EntryDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="360" Height="330" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" Background="Transparent"
        AllowsTransparency="True" WindowStartupLocation="CenterScreen">
    <Border CornerRadius="18" Background="#171A1F" BorderBrush="#22D3EE" BorderThickness="1" Padding="16">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <TextBlock x:Name="TitleText" Foreground="#22D3EE" FontSize="13" FontWeight="Bold"/>
                <Button Content="×" Width="28" Height="28" HorizontalAlignment="Right" Click="Cancel_Click" Background="#20242A" Foreground="#DDEAF0" BorderBrush="#343C47"/>
            </Grid>
            <StackPanel Grid.Row="1">
                <TextBlock x:Name="NameLabel" Text="Nama" Foreground="#AFC0CF" FontSize="9" Margin="0,0,0,4"/>
                <TextBox x:Name="NameBox" Height="32" Padding="8" Background="#101216" Foreground="#F8FAFC" BorderBrush="#343C47" Margin="0,0,0,10"/>
                <TextBlock x:Name="DateLabel" Text="Tanggal &amp; waktu" Foreground="#AFC0CF" FontSize="9" Margin="0,0,0,4"/>
                <DatePicker x:Name="DateBox" Height="32" Background="#101216" Foreground="#F8FAFC" Margin="0,0,0,10"/>
                <TextBlock x:Name="PriorityLabel" Text="Prioritas" Foreground="#AFC0CF" FontSize="9" Margin="0,0,0,4"/>
                <ComboBox x:Name="PriorityBox" Height="32" Background="#101216" Foreground="#F8FAFC" Margin="0,0,0,10">
                    <ComboBoxItem Content="Tinggi"/><ComboBoxItem Content="Sedang" IsSelected="True"/><ComboBoxItem Content="Rendah"/>
                </ComboBox>
                <TextBlock x:Name="NotesLabel" Text="Catatan" Foreground="#AFC0CF" FontSize="9" Margin="0,0,0,4"/>
                <TextBox x:Name="NotesBox" Height="48" Padding="8" Background="#101216" Foreground="#F8FAFC" BorderBrush="#343C47" TextWrapping="Wrap" AcceptsReturn="True"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Batal" Width="76" Height="30" Margin="0,0,7,0" Click="Cancel_Click" Background="#20242A" Foreground="#C8D2DA" BorderBrush="#343C47"/>
                <Button Content="Simpan" Width="92" Height="30" Click="Save_Click" Background="#22D3EE" Foreground="#061015" BorderThickness="0" FontWeight="Bold"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
